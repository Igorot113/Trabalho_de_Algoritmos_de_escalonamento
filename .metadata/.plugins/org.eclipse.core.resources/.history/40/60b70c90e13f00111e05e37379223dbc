package round_robin;

import java.util.ArrayList;
import java.util.List;

import tarefa.Tarefa;

public class RoundRobin {
	Tarefa tarefa;
	List<Tarefa> escalonador = new ArrayList<>();
	private final int quantum = 3;

	public void AdicionarProcessos(Tarefa tarefa) {
		System.out.printf("Processo %s adicionado no escalonador.", tarefa.getNome());
		escalonador.add(tarefa);
	}

	public void EnviarParaCPU() {
		System.out.printf("Processo %s enviado para o processador.", escalonador.get(0).getNome());
		escalonador.removeFirst();
	}

	public void ExecutandoProcesso() {
		int tempoGasto = tarefa.getTempo() - quantum;
		tarefa.setTempo(tempoGasto);
	}

	public boolean Verificacoes() {
		if (tarefa.finalizada) {
			return true;
		} else {
			return false;
		}
	}
}
