package round_robin;

import java.util.ArrayList;
import java.util.List;

import tarefa.Tarefa;

public class RoundRobin {
	List<Tarefa> escalonador = new ArrayList<>();
	private int quantum;

	public void AdicionarProcessos(Tarefa tarefa) {
		System.out.printf("Processo %s adicionado no escalonador.", escalonador.get(0).getNome());
		escalonador.add(tarefa);
	}

	public void EnviarParaACPU(Tarefa tarefa) {
		System.out.printf("Processo %s enviado para o processador.", escalonador.get(0).getNome());
		escalonador.removeFirst();
	}

	public boolean VericarTempoETarefaConcluida(Tarefa tarefa) {
		if (!tarefa.finalizada && tarefa.tempo > quantum ) {
			tarefa
			return true;
		} else {
			return false;
		}
	}
}
